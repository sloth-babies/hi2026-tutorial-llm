---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	structuredData?: unknown;
}

const { title, description, structuredData } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL('https://sloth-babies.github.io');
const canonicalUrl = new URL(`${base}/`, siteUrl).toString();
const socialImageUrl = new URL(`${base}/og-image.svg`, siteUrl).toString();
const pageTitle = `${title} | HI2026 - COURSE 03`;
const structuredDataJson = structuredData
	? JSON.stringify(structuredData).replace(/</g, '\\u003c')
	: undefined;
---

<!doctype html>
<html lang="ja" data-theme="system">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" data-theme-color />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="HI2026 - COURSE 03" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:secure_url" content={socialImageUrl} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="HI2026 - COURSE 03 LLM講習会" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="HI2026 - COURSE 03 LLM講習会" />
		<link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`} />
		{structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
		<script is:inline>
			(() => {
			const themeStorageKey = 'hi2026-theme';
			const validThemes = ['system', 'light', 'dark'];
			let initialTheme = 'system';

			try {
				const storedTheme = localStorage.getItem(themeStorageKey);
				if (validThemes.includes(storedTheme)) initialTheme = storedTheme;
			} catch {
				// Use the system preference when localStorage is unavailable.
			}

			document.documentElement.dataset.theme = initialTheme;
			const initialIsDark = initialTheme === 'dark' ||
				(initialTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
			document.querySelector('[data-theme-color]')?.setAttribute('content', initialIsDark ? '#121516' : '#ffffff');
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">本文へ移動</a>
		<slot />
	</body>
</html>
